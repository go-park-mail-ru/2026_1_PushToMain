                        "name": "is_anonymous",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Вложения (multipart)",
                        "name": "attachments",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.SendEmailResponse"
                        }
                    },
                    "400": {
                        "description": "Пустое тело или некорректный запрос",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "403": {
